              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " descreva uma semana cheia (real ou fictícia) usando 5 expressões de carga de trabalho."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Parte 2 — Pedir ajuda (5 min):",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " você está "
