      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dia 1 — Caderno.",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " Anote as expressões em 5 grupos de emoção."
