        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Lição 14 – Advérbios de frequência"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "I always study. He sometimes eats pizza. They never watch movies.",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": "She usually goes to the gym. We rarely drink soda.",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": "You often visit your family.",
            "marks": [
              {
                "type": "italic"
              }
            ]
          }
        ]
