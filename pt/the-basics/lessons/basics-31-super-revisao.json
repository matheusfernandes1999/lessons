      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Lição 15 – Preposições de lugar e tempo"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The book is on the table. I was born in July. We meet at 6 pm.",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": "The keys are in my bag. The party is at night.",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": "He works on Mondays. She is at school now.",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": "The picture is above the sofa. The meeting is in the morning.",
            "marks": [
              {
                "type": "italic"
              }
            ]
          }
        ]
