        },
        "content": [
          {
            "type": "text",
            "text": "Lição 13 – Frases negativas"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "I am not hungry. She doesn’t like coffee. They didn’t go to the party.",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": "He is not tired today. We don’t play tennis.",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": "You didn’t finish your homework.",
            "marks": [
              {
                "type": "italic"
              }
            ]
          }
        ]
      },
