        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Professor anota:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " reconheceu ☐ · discordou suave ☐☐ · alternativa ☐ · motivos ☐☐ · acordo ☐"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "5. Feedback (5 min)"
