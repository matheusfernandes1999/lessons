          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Adults should sleep at least seven hours. 6. Most adults in the world sleep more than nine hours. 7. Scientists fully understand why short sleep is linked to weight gain. 8. Short naps can improve alertness."
                  }
                ]
              }
            ]
          }
        ]
