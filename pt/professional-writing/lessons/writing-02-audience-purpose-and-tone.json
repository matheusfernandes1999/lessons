                  {
                    "type": "italic"
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Neutro (gestora):",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": " "
              },
              {
                "type": "text",
                "text": "Hi Sarah, Just to let you know, the Hughes order will be two days late. I've informed the client.",
                "marks": [
                  {
                    "type": "italic"
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Informal (colega no chat):",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": " "
              },
              {
                "type": "text",
                "text": "Heads-up: Hughes order's 2 days late 😕 client knows.",
                "marks": [
                  {
                    "type": "italic"
                  }
                ]
