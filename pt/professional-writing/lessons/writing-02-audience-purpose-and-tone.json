      {
        "type": "blockquote",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Formal (cliente novo):",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": " "
              },
              {
                "type": "text",
                "text": "Dear Mr Hughes, I am writing to inform you that your order will be delayed by two days. We apologise for any inconvenience.",
