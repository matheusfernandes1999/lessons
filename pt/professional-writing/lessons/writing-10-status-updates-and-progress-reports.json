              "category": "vocabulary",
              "questionText": "“On track” means…",
              "type": "multiple-choice",
              "options": [
                {
                  "id": "A",
                  "text": "progressing as planned"
                },
                {
                  "id": "B",
                  "text": "late"
                }
              ],
              "correctOptionId": "A",
              "explanations": {
                "A": "Correto.",
                "B": "Isso é “behind schedule”.",
                "general": "Correct answer: progressing as planned"
              }
            },
            {
              "id": "vocab-mc-2",
              "category": "vocabulary",
              "questionText": "A “blocker” is…",
              "type": "multiple-choice",
              "options": [
                {
                  "id": "A",
                  "text": "something that stops progress"
                },
                {
                  "id": "B",
                  "text": "a finished task"
                }
