              "correctOptionId": "A",
              "explanations": {
                "A": "Correto.",
                "B": "Não.",
                "general": "Correct answer: something that stops progress"
              }
            },
            {
              "id": "vocab-mc-3",
              "category": "vocabulary",
              "questionText": "For a recent result, use…",
