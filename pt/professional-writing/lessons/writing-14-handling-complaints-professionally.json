            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "I ordered a coffee machine (order #3381) two weeks ago. It arrived yesterday with a broken lid. This is the second time this has happened. I'm very disappointed.",
                "marks": [
                  {
                    "type": "italic"
                  }
                ]
              }
            ]
