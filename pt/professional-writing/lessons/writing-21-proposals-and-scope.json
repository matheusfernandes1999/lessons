              "id": "vocab-mc-1",
              "category": "vocabulary",
              "questionText": "“Out of scope” means…",
              "type": "multiple-choice",
              "options": [
                {
                  "id": "A",
                  "text": "not included in the project"
                },
                {
                  "id": "B",
                  "text": "very important"
                }
              ],
              "correctOptionId": "A",
              "explanations": {
                "A": "Correto.",
                "B": "Não.",
                "general": "Correct answer: not included in the project"
              }
            },
            {
              "id": "vocab-mc-2",
              "category": "vocabulary",
              "questionText": "An “assumption” in a proposal is…",
              "type": "multiple-choice",
              "options": [
                {
                  "id": "A",
                  "text": "a condition you expect to be true"
                },
                {
                  "id": "B",
                  "text": "a payment"
                }
              ],
              "correctOptionId": "A",
              "explanations": {
                "A": "Correto.",
                "B": "Não.",
                "general": "Correct answer: a condition you expect to be true"
              }
            },
            {
              "id": "vocab-mc-3",
              "category": "comprehension",
              "questionText": "Polite response to an extra request:",
              "type": "multiple-choice",
              "options": [
                {
                  "id": "A",
                  "text": "It's outside the current scope, but we'd be happy to provide a quote."
                },
                {
                  "id": "B",
                  "text": "No, that's not my job."
                }
              ],
              "correctOptionId": "A",
              "explanations": {
                "A": "Correto.",
                "B": "Rude.",
                "general": "Correct answer: It's outside the current scope, but we'd be happy to provide a quote."
