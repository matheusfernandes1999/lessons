              "id": "vocab-mc-1",
              "category": "vocabulary",
              "questionText": "Which request is the most polite?",
              "type": "multiple-choice",
              "options": [
                {
                  "id": "A",
                  "text": "Send me the file."
                },
                {
                  "id": "B",
                  "text": "Can you send me the file?"
                },
                {
                  "id": "C",
                  "text": "I was wondering if you could send me the file."
                }
              ],
              "correctOptionId": "C",
              "explanations": {
                "A": "Ordem.",
                "B": "Neutro/informal.",
                "C": "Mais indireto e educado.",
                "general": "Correct answer: I was wondering if you could send me the file."
              }
            },
            {
              "id": "vocab-mc-2",
              "category": "comprehension",
              "questionText": "“Do you mind if I sit here?” — How do you say YES (you can sit)?",
