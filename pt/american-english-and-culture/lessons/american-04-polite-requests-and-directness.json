              "options": [
                {
                  "id": "A",
                  "text": "No, go ahead."
                },
                {
                  "id": "B",
                  "text": "Yes, I mind."
                }
              ],
              "correctOptionId": "A",
              "explanations": {
                "A": "“Não me importo” = pode sentar.",
                "B": "Significa que você se importa.",
                "general": "Correct answer: No, go ahead."
              }
            },
