                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Exemplo de Meta Semanal:",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " \"Vou aprender 7 novas palavras relacionadas a 'trabalho' e usar cada uma delas em uma frase.\""
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
