              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "O aluno vai conseguir contar até 9 no final da aula e conseguir identificar a maioria das cores. Ele também vai conseguir responder perguntas como ‘how many?’ e ‘what color?’."
                  }
                ]
              }
            ]
