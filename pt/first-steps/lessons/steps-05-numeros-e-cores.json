      },
      {
        "type": "paragraph"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Conteúdo principal da aula:",
            "marks": [
              {
                "type": "textStyle",
                "attrs": {
                  "color": "rgb(255, 191, 0)"
                }
              },
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " numbers, colors, the, is, and, of, a, in, to, that"
