                "type": "textStyle",
                "attrs": {
                  "color": "rgb(255, 191, 0)"
                }
              },
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " para cada assunto (ou use o da apostila). Anote suas dúvidas."
          }
        ]
      },
