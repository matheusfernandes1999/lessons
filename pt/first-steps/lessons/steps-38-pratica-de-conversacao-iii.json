          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Prefer",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " é usado para dizer o que você gosta mais entre duas opções ou mais."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "✅ "
          },
          {
            "type": "text",
            "text": "Estrutura básica:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "I prefer X to Y.",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " → "
                  },
                  {
                    "type": "text",
                    "text": "I prefer tea to coffee.",
                    "marks": [
                      {
                        "type": "italic"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " (Eu prefiro chá a café.)"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "I’d rather (verbo sem “to”) than...",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " → "
                  },
                  {
                    "type": "text",
                    "text": "I’d rather stay home than go out.",
                    "marks": [
                      {
                        "type": "italic"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " (Prefiro ficar em casa do que sair.)"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Exemplo:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "\"I prefer the blue shirt to the red one.\""
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
