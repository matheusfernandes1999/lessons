              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Exemplo:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "hardBreak"
          },
          {
            "type": "text",
            "text": "\"My sister wakes up at 6 am. She goes to school at 7:30 am and studies until 1 pm. She usually has lunch with our family. In the afternoon, she does her homework and sometimes watches TV. She goes to bed at 9 pm.\"",
            "marks": [
              {
                "type": "italic"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph"
      },
      {
        "type": "heading",
