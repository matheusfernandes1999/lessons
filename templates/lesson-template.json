              "questionText": "Which word means “ponto forte”?",
              "type": "multiple-choice",
              "options": [
                {
                  "id": "A",
                  "text": "weakness"
                },
                {
                  "id": "B",
                  "text": "strength"
                },
                {
                  "id": "C",
                  "text": "deadline"
                },
                {
                  "id": "D",
                  "text": "prompt"
                }
              ],
              "correctOptionId": "B",
              "explanations": {
                "A": "Weakness = ponto fraco.",
                "B": "Strength = ponto forte. Reading is my strength.",
                "C": "Deadline = prazo.",
                "D": "Prompt = enunciado da tarefa.",
                "general": "Correct answer: strength"
              }
            },
            {
              "id": "vocab-mc-2",
